<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SC001" targetNamespace="https://example.org/inkafarma/gestion-cambios">
  <bpmn:process id="Process_SC001" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane0" name="Solicitante">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>req</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane1" name="Responsable de cambios">
        <bpmn:flowNodeRef>eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane2" name="Aprobador">
        <bpmn:flowNodeRef>dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endno</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane3" name="Desarrollador">
        <bpmn:flowNodeRef>impl</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane4" name="Revisor / QA">
        <bpmn:flowNodeRef>test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Inicio" />
    <bpmn:task id="req" name="Registrar solicitud" />
    <bpmn:task id="eval" name="Evaluar impacto" />
    <bpmn:task id="dec" name="Evaluar y registrar decisión" />
    <bpmn:exclusiveGateway id="g" name="¿Aprobado?" />
    <bpmn:task id="rej" name="Registrar rechazo" />
    <bpmn:endEvent id="endno" name="Fin sin cambio" />
    <bpmn:task id="impl" name="Implementar ajuste" />
    <bpmn:task id="test" name="Validar cambio" />
    <bpmn:exclusiveGateway id="ok" name="¿Cumple?" />
    <bpmn:task id="pr" name="Revisar PR e integrar" />
    <bpmn:task id="close" name="Registrar y cerrar" />
    <bpmn:endEvent id="end" name="Fin" />
    <bpmn:sequenceFlow id="F0" sourceRef="s" targetRef="req" />
    <bpmn:sequenceFlow id="F1" sourceRef="req" targetRef="eval" />
    <bpmn:sequenceFlow id="F2" sourceRef="eval" targetRef="dec" />
    <bpmn:sequenceFlow id="F3" sourceRef="dec" targetRef="g" />
    <bpmn:sequenceFlow id="F4" sourceRef="g" targetRef="rej" name="No" />
    <bpmn:sequenceFlow id="F5" sourceRef="rej" targetRef="endno" />
    <bpmn:sequenceFlow id="F6" sourceRef="g" targetRef="impl" name="Sí" />
    <bpmn:sequenceFlow id="F7" sourceRef="impl" targetRef="test" />
    <bpmn:sequenceFlow id="F8" sourceRef="test" targetRef="ok" />
    <bpmn:sequenceFlow id="F9" sourceRef="ok" targetRef="impl" name="No" />
    <bpmn:sequenceFlow id="F10" sourceRef="ok" targetRef="pr" name="Sí" />
    <bpmn:sequenceFlow id="F11" sourceRef="pr" targetRef="close" />
    <bpmn:sequenceFlow id="F12" sourceRef="close" targetRef="end" />
  </bpmn:process>
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool" name="Inkafarma — Gestión de cambio menor" processRef="Process_SC001" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
