Align=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="1740" width="350" height="130" /></mxCell><mxCell id="n7" value="«control»&#10;inventario : Inventario y alertas" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#EDF3FC;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="980" width="350" height="130" /></mxCell><mxCell id="n8" value="«entity»&#10;datos : Stock y suscripciones" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#F3F4F5;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1600" y="220" width="350" height="130" /></mxCell><mxCell id="n9" value="«actor»&#10;cliente : Cliente suscrito" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1600" y="1740" width="350" height="130" /></mxCell><mxCell id="n11" value="1: cliente → inventario | [C1] activarAlerta(producto)&#10;3: inventario → cliente | [C1] confirmarSolicitudRegistrada()&#10;12: inventario → cliente | [C3,C7] enviarAvisoDeDisponibilidad()&#10;13: cliente → inventario | [C3,C8] iniciarCompra(G02)" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="1412.8" width="750" height="104.4" /></mxCell><mxCell id="n13" value="2: inventario → datos | [C1] guardarSuscripciónAutorizada()&#10;7: inventario → datos | [C3,C4] descontarSalidaUnaVez()&#10;8: inventario → datos | [C3,C5] sumarIngreso()&#10;9: inventario → datos | [C3,C6] corregirConTrazabilidad()&#10;10: datos → inventario | [C3] stockActualizado&#10;11: inventario → datos | [C3] leerAlertasSiStockRepuesto()" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="650.7" width="750" height="148.6" /></mxCell><mxCell id="n15" value="4: admin → canal | registrarVentaIngresoOCorrección()" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1015.95" width="550" height="38.1" /></mxCell><mxCell id="n17" value="5: canal → inventario | validarRolYMovimiento()&#10;6: inventario → canal | [C2] rechazarSinModificarStock()" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="1434.9" width="620" height="60.2" /></mxCell><mxCell id="n18" value="Condiciones de los mensajes (mismas guardas que en secuencia)" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="2230" width="2000" height="40" /></mxCell><mxCell id="n19" value="C1 (opt): medicamento agotado: cliente solicita alerta&#10;C3 (alt): movimiento válido&#10;C5 (alt): ingreso&#10;C7 (loop): por cada cliente suscrito cuando hay reposición" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="2280" width="950" height="120" /></mxCell><mxCell id="n20" value="C2 (alt): movimiento no válido&#10;C4 (alt): venta&#10;C6 (alt): corrección autorizada&#10;C8 (opt): cliente abre aviso" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="2280" width="950" height="120" /></mxCell></root></mxGraphModel></diagram></mxfile>