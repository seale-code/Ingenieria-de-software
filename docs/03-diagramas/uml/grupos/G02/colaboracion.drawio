diciones de los mensajes (mismas guardas que en secuencia)" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="2230" width="2000" height="40" /></mxCell><mxCell id="n23" value="C1 (opt): sin acceso válido: terminar&#10;C3 (loop): por cada producto que agrega&#10;C5 (opt): solicita ayuda&#10;C7 (opt): cambia de canal&#10;C9 (alt): rechazado" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="2280" width="950" height="145" /></mxCell><mxCell id="n24" value="C2 (opt): acceso válido: continuar&#10;C4 (opt): repetir compra&#10;C6 (opt): requiere especialista&#10;C8 (alt): aceptado" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="2280" width="950" height="145" /></mxCell></root></mxGraphModel></diagram></mxfile>