#FFFFFF;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="220" width="350" height="130" /></mxCell><mxCell id="n6" value="«actor»&#10;admin : Administrador de&#10;plataforma" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="1740" width="350" height="130" /></mxCell><mxCell id="n7" value="«control»&#10;gestor : Reservas y asignación" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#EDF3FC;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="980" width="350" height="130" /></mxCell><mxCell id="n8" value="«entity»&#10;datos : Stock, reservas e historial" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#F3F4F5;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1600" y="220" width="350" height="130" /></mxCell><mxCell id="n9" value="«actor»&#10;sucursal : Personal de sucursal" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1600" y="1740" width="350" height="130" /></mxCell><mxCell id="n11" value="1: cliente → gestor | confirmarReserva(items, ubicación)&#10;5: gestor → cliente | [C1] informarSinDisponibilidad()&#10;19: gestor → cliente | [C2,C6,C11] confirmarAtención()&#10;21: gestor → cliente | [C2,C6,C12] informarReservaVencida()&#10;22: gestor → cliente | [C2,C13] informarReservaNoCreada()" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="661.75" width="620" height="126.5" /></mxCell><mxCell id="n13" value="2: gestor → datos | leerStockDistanciaCapacidad()&#10;3: datos → gestor | sucursalesElegibles&#10;6: gestor → datos | [C2,C3] reservarAtómicamente(T)&#10;7: datos → gestor | [C2,C3,C4] conflictoDeStock&#10;8: gestor → datos | [C2,C3,C4] revalidarCandidatasActualizadas()&#10;9: datos → gestor | [C2,C3,C5] pedidoYReserva&#10;14: gestor → datos | [C2,C6,C7] buscarAlternativa(excluirFallida)&#10;15: gestor → datos | [C2,C6,C7,C8] reasignarReservasYGuardarHistorial()&#10;18: gestor → datos | [C2,C6,C11] vincularReservaAlPedido()&#10;20: gestor → datos | [C2,C6,C12] liberarReservaYDisponibilidad()" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="606.5" width="750" height="237.0" /></mxCell><mxCell id="n15" value="4: gestor → gestor | priorizarCercaníaYStock()&#10;11: gestor → gestor | [C2,C6,C7] detectarRestricciónOFaltaDeConfirmación()" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1270" y="1072.4" width="760" height="60.2" /></mxCell><mxCell id="n17" value="10: gestor → sucursal | [C2,C6] notificarNuevaReserva()&#10;16: gestor → sucursal | [C2,C6,C7,C8] notificarSucursalAlternativa()" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="1434.9" width="750" height="60.2" /></mxCell><mxCell id="n19" value="12: gestor → admin | [C2,C6,C7] alertarRiesgoDeCancelación()&#10;13: admin → gestor | [C2,C6,C7] consultarRiesgo()&#10;17: gestor → admin | [C2,C6,C7,C9,C10]&#10;informarPendienteDeAtención()" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="1412.8" width="620" height="104.4" /></mxCell><mxCell id="n20" value="Condiciones de los mensajes (mismas guardas que en secuencia)" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="2230" width="2000" height="40" /></mxCell><mxCell id="n21" value="C1 (alt): sin alternativa&#10;C3 (loop): mientras haya candidatas y no exista reserva&#10;C5 (alt): reserva creada&#10;C7 (opt): sucursal no confirma o no puede atender&#10;C9 (alt): sin alternativa&#10;C11 (alt): compra concretada antes de T&#10;C13 (alt): candidatas agotadas sin reserva" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="2280" width="950" height="195" /></mxCell><mxCell id="n22" value="C2 (alt): hay sucursal elegible&#10;C4 (alt): conflicto de concurrencia&#10;C6 (alt): reserva creada&#10;C8 (alt): existe alternativa&#10;C10 (break): requiere atención del administrador&#10;C12 (alt): vence T sin compra" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="2280" width="950" height="195" /></mxCell></root></mxGraphModel></diagram></mxfile>