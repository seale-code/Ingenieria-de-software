<mxfile host="app.diagrams.net" agent="Inkafarma - modelo de análisis"><diagram id="G04-COL" name="G04 | Diagrama de colaboración (comunicación)"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="2505" math="0" shadow="0" background="#FFFFFF" adaptiveColors="none"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="e10" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=0;strokeColor=#263D36;strokeWidth=1.5;dashed=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="325.0" y="350.0" /><mxPoint as="targetPoint" x="325.0" y="1740.0" /></mxGeometry></mxCell><mxCell id="e12" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=0;strokeColor=#263D36;strokeWidth=1.5;dashed=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="389.14" y="1740.0" /><mxPoint as="targetPoint" x="1010.86" y="1110.0" /></mxGeometry></mxCell><mxCell id="e14" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=0;strokeColor=#263D36;strokeWidth=1.5;dashed=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1134.87" y="980.0" /><mxPoint as="targetPoint" x="1715.13" y="350.0" /></mxGeometry></mxCell><mxCell id="e16" style="edgeStyle=none;rounded=0;html=0;endArrow=none;endFill=0;strokeColor=#263D36;strokeWidth=1.5;dashed=0;" edge="1" parent="1" source="n7" target="n9"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1134.87" y="1110.0" /><mxPoint as="targetPoint" x="1715.13" y="1740.0" /></mxGeometry></mxCell><mxCell id="n1" value="G04 | Diagrama de colaboración (comunicación)" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=28;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="20" width="2010" height="55" /></mxCell><mxCell id="n2" value="Seguimiento y entrega | HU05, HU15" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="80" width="2010" height="45" /></mxCell><mxCell id="n3" value="Acceso personal; central coordina reparto, sucursal opera solo su sede. Seguimiento por código; sin recojo ni avisos externos." style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=16;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#EAF5EF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="2405" width="2010" height="60" /></mxCell><mxCell id="n4" value="Inkafarma | AS-IS v6 remediada | DOC-02 #61" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=12;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="2469" width="2010" height="32" /></mxCell><mxCell id="n5" value="«actor»&#10;actor : Operador / cliente" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="220" width="350" height="130" /></mxCell><mxCell id="n6" value="«boundary»&#10;web : Panel / seguimiento" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#EAF5EF;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="1740" width="350" height="130" /></mxCell><mxCell id="n7" value="«control»&#10;api : API operaciones" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#EDF3FC;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="980" width="350" height="130" /></mxCell><mxCell id="n8" value="«entity»&#10;db : SQLite" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#F3F4F5;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1600" y="220" width="350" height="130" /></mxCell><mxCell id="n9" value="«control»&#10;extra : Servicio de reparto" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#EDF3FC;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1600" y="1740" width="350" height="130" /></mxCell><mxCell id="n11" value="1: actor → web | [C1] ingresar código privado&#10;6: web → actor | [C1] mostrar resultado&#10;7: actor → web | [C2] usuario y contraseña" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="993.85" width="550" height="82.3" /></mxCell><mxCell id="n13" value="2: web → api | [C1] GET /api/seguimiento (código)&#10;5: api → web | [C1] resultado público o error&#10;8: web → api | [C2] POST sesión personal; límite de intentos&#10;9: api → web | [C2] sesión / CSRF o 401 / 429&#10;10: web → api | [C2,C3] preparar / listo; central asigna&#10;12: web → api | [C2,C3,C4] central: incidencia / cancelar&#10;14: web → api | [C2,C3,C5] central: salir / entregar&#10;17: api → web | [C2,C3,C5] estado actualizado" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="1368.6" width="620" height="192.8" /></mxCell><mxCell id="n15" value="3: api → db | [C1] leer estado e historial&#10;4: db → api | [C1] datos o ausencia&#10;11: api → db | [C2,C3] validar sede, asignación y auditar&#10;13: api → db | [C2,C3,C4] registrar resultado" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="672.8" width="750" height="104.4" /></mxCell><mxCell id="n17" value="15: api → extra | [C2,C3,C5] avanzar_reparto&#10;16: extra → api | [C2,C3,C5] transición y resultado" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="1434.9" width="750" height="60.2" /></mxCell><mxCell id="n18" value="Condiciones de los mensajes (mismas guardas que en secuencia)" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="2230" width="2000" height="40" /></mxCell><mxCell id="n19" value="C1 (alt): seguimiento público&#10;C3 (opt): sesión válida&#10;C5 (opt): pedido apto para despacho" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="2280" width="950" height="95" /></mxCell><mxCell id="n20" value="C2 (alt): operaciones autorizadas&#10;C4 (opt): incidencia o cancelación permitida" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="2280" width="950" height="95" /></mxCell></root></mxGraphModel></diagram></mxfile>