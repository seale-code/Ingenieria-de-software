=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=28;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="20" width="1058.02" height="55" /></mxCell><mxCell id="n2" value="Compra web y cotización | HU04, HU08, HU10, HU11, HU12" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="80" width="1058.02" height="45" /></mxCell><mxCell id="n3" value="Compra sin cuenta de cliente; llamada humana y código vigente antes de confirmar. Sin chat, historial ni integración de&#10;canales." style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=16;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#EAF5EF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1718.98" width="1058.02" height="60" /></mxCell><mxCell id="n4" value="Inkafarma | AS-IS v6 remediada | DOC-02 #61" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=12;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1782.98" width="1058.02" height="32" /></mxCell><mxCell id="s" value="" style="shape=ellipse;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=18;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#263D36;align=center;verticalAlign=middle;perimeter=ellipsePerimeter;" vertex="1" parent="1"><mxGeometry as="geometry" x="496.0" y="149.98" width="14.0" height="14.0" /></mxCell><mxCell id="a" value="Seleccionar productos y cantidades" style="shape=rectangle;html=0;whiteSpace=wr