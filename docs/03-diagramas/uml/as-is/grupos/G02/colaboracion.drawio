le;strokeColor=none;spacing=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="20" width="2010" height="55" /></mxCell><mxCell id="n2" value="Compra web y cotización | HU04, HU08, HU10, HU11, HU12" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="80" width="2010" height="45" /></mxCell><mxCell id="n3" value="Compra sin cuenta de cliente; llamada humana y código vigente antes de confirmar. Sin chat, historial ni integración de canales." style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=16;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#EAF5EF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="2380" width="2010" height="60" /></mxCell><mxCell id="n4" value="Inkafarma | AS-IS v6 remediada | DOC-02 #61" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=12;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="2444" width="2010" height="32" /></mxCell><mxCell id="n5" value="«actor»&#10;actor : Cliente" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="220" width="350" height="130" /></mxCell><mxCell id="n6" value="«boundary»&#10;web : Carrito web" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#EAF5EF;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="150" y="1740" width="350" height="130" /></mxCell><mxCell id="n7" value="«control»&#10;api : API / seguridad / pedidos" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#EDF3FC;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="980" width="350" height="130" /></mxCell><mxCell id="n8" value="«entity»&#10;db : SQLite" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#F3F4F5;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1600" y="220" width="350" height="130" /></mxCell><mxCell id="n9" value="«control»&#10;extra : Operador CLI / logística" style="shape=rectangle;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#EDF3FC;align=center;verticalAlign=middle;fontStyle=4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1600" y="1740" width="350" height="130" /></mxCell><mxCell id="n11" value="1: actor → web | seleccionar artículos&#10;6: web → actor | [C1] mostrar importe&#10;7: actor → web | [C1] datos y solicitar llamada&#10;12: actor → web | [C1] ingresar código recibido por llamada&#10;17: web → actor | [C1,C2] mostrar confirmación&#10;19: web → actor | [C1,C3] mostrar revisión requerida&#10;21: web → actor | [C4] corregir carrito" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="949.65" width="550" height="170.7" /></mxCell><mxCell id="n13" value="2: web → api | POST /api/pedidos/cotizacion&#10;5: api → web | [C1] subtotal, envío, total, huella&#10;8: web → api | [C1] POST /api/pedidos/verificacion&#10;13: web → api | [C1] POST /api/pedidos con código&#10;16: api → web | [C1,C2] pedido y código&#10;18: api → web | [C1,C3] error HTTP&#10;20: api → web | [C4] error 400" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="1379.65" width="620" height="170.7" /></mxCell><mxCell id="n15" value="3: api → db | leer precios y límites&#10;4: db → api | datos comerciales&#10;9: api → db | [C1] guardar solicitud ligada a teléfono y UUID" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="683.85" width="750" height="82.3" /></mxCell><mxCell id="n17" value="10: extra → api | [C1] CLI: consultar y emitir código&#10;11: api → extra | [C1] teléfono y código; llamada humana fuera de web&#10;14: api → extra | [C1] verificar contacto y registrar (G03)&#10;15: extra → api | [C1] pedido o conflicto" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="1412.8" width="750" height="104.4" /></mxCell><mxCell id="n18" value="Condiciones de los mensajes (mismas guardas que en secuencia)" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=19;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="2230" width="2000" height="40" /></mxCell><mxCell id="n19" value="C1 (alt): cotización válida&#10;C3 (alt): precio cambiado, sin asignación o error" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="2280" width="950" height="70" /></mxCell><mxCell id="n20" value="C2 (alt): pedido confirmado&#10;C4 (alt): cotización inválida" style="shape=text;html=0;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=17;fontColor=#263D36;strokeColor=#263D36;strokeWidth=1.6;fillColor=#FFFFFF;align=left;verticalAlign=middle;strokeColor=none;spacing=5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="2280" width="950" height="70" /></mxCell></root></mxGraphModel></diagram></mxfile>